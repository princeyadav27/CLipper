    "# ==========================================\n",
    "# CELL 4: Setup Colab Data Folder & Fonts\n",
    "# ==========================================\n",
    "\n",
    "# Set Colab-optimized data folder\n",
    "os.environ['CLIPKONTRAST_DATA'] = '/content/ClipKontrast/data'\n",
    "os.environ['CLIPKONTRAST_HOST'] = '0.0.0.0'\n",
    "os.environ['CLIPKONTRAST_PORT'] = '8765'\n",
    "\n",
    "# Create data directory\n",
    "import pathlib\n",
    "data_dir = pathlib.Path('/content/ClipKontrast/data')\n",
    "data_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Create subdirectories for optimal workflow\n",
    "for sub in ['users', 'tmp', 'models', 'fonts', 'clips', 'recordings', 'cache']:\n",
    "    (data_dir / sub).mkdir(exist_ok=True)\n",
    "\n",
    "# Copy fonts from studio/fonts to data/fonts for consistent rendering\n",
    "import shutil\n",
    "fonts_src = Path('/content/ClipKontrast/studio/fonts')\n",
    "fonts_dst = data_dir / 'fonts'\n",
    "if fonts_src.exists():\n",
    "     shutil.copytree(fonts_src, fonts_dst, dirs_exist_ok=True)\n",
    "     print('🔤 Fonts copied successfully!')\n",
    "else:\n",
    "     print('⚠️  No source fonts folder found, using defaults')\n",
    "\n",
    "# Set AI ready flag\n",
    "os.environ['CLIPKONTRAST_AI_READY'] = 'true'\n",
    "\n",
    "# Set sherpa-onnx model with GPU awareness\n",
    "# The model will automatically use GPU if available via CUDA\n",
    "asr_model_name = os.environ.get('CLIPKONTRAST_ASR_MODEL', 'sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8')\n",
    "print(f'🎤 ASR Model: {asr_model_name}')\n",
    "print(f'🖥️ GPU offloading enabled (SHERPA_ONNX_OFFLOAD={os.environ.get(\"SHERPA_ONNX_OFFLOAD\")})')\n",
    "\n",
    "print('\\n✅ Data folder setup complete!')\n",
    f"📁 Data folder: {data_dir}`\n",
    "\n",
    "# Print final configuration summary\n",
    "print('\\n📊 FINAL CONFIGURATION SUMMARY:')\n",
    "  print('━' * 50)\n",
    "  print(f'  🤖 AI Provider: {os.environ.get(\"CLIPKONTRAST_AI_PROVIDER\")}')\n",
    "  print(f'  🤖 AI Models: {os.environ.get(\"CLIPKONTRAST_AI_MODELS\")}')\n",
    "  print(f'  🔑 AI Key: **********`)  \n",
    "  print(f'  🌐 Base URL: {os.environ.get(\"CLIPKONTRAST_AI_BASE_URL\")}')\n",
    "  print('  ')\n",
    "  print(f'  ⚡ GPU Offload: {os.environ.get(\"SHERPA_ONNX_OFFLOAD\")}')\n",
    "  print(f'  🔢 Job Workers: {os.environ.get(\"CLIPKONTRAST_JOB_WORKERS\")} (concurrent videos)')\n",
    "  print(f'  📝 Transcript-First: {os.environ.get(\"CLIPKONTRAST_FAST_URLS\")} (NO full audio download!)')\n",
    "  print(f'  ⏭️ Skip Static: {os.environ.get(\"CLIPKONTRAST_SKIP_STATIC\")}')\n",
    "  print(f'  ⏱️ AI Timeout: {os.environ.get(\"CLIPKONTRAST_LIVE_AI_TIMEOUT\")}s')\n",
    "  print(f'  👥 Accounts: {os.environ.get(\"CLIPKONTRAST_ACCOUNTS\")}')\n",
    "  print(f'  📥 Model Fetch: {os.environ.get(\"CLIPKONTRAST_FETCH_MODEL\")}')\n",
    "  print('━' * 50)\n",
    "\n",
    "print('\\n✅ All optimizations configured for MAXIMUM SPEED!')"
   ]
