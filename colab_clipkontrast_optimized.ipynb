    "# ==========================================\n",
    "# CELL 5: Download/Initialize Speech Model with GPU Support\n",
    "# ==========================================\n",
    "\n",
    "# Initialize the speech model - will use GPU if available via CUDA\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "print('📥 Initializing speech model with GPU support...')\n",
    "\n",
    "# The fetch_model module handles downloading/loading the Parakeet model\n",
    "# With SHERPA_ONNX_OFFLOAD=1, it will use GPU if available\n",
    "result = subprocess.run(\n",
    "    [sys.executable, '-m', 'studio.fetch_model', 'ensure'],\n",
    "    cwd='/content/ClipKontrast',\n",
    "    capture_output=True,\n",
    "    text=True\n",
    ")\n",
    "print(result.stdout[-800:] if len(result.stdout) > 800 else result.stdout)\n",
    "print(result.stderr[-800:] if len(result.stderr) > 800 else result.stderr)\n",
    "\n",
    "if result.returncode == 0:\n",
    "    print('✅ Speech model ready!')\n",
    "    # Check if GPU is being used\n",
    "    import torch\n",
    "    if torch.cuda.is_available():\n",
    "        print(f'   🚀 GPU ACCELERATED: {torch.cuda.get_device_name(0)}')\n",
    "else:\n",
    "    print('⚠️  Model download had issues, but app will download on first use')\n",
    "    print('   (YouTube transcript-first mode will still work without full STT)')\n",
    "\n",
    "# Final GPU check\n",
    "print('\\n🖥️ Final GPU Status:')\n",
    "import torch\n",
    "if torch.cuda.is_available():\n",
    "    print(f'  ✅ CUDA Available! GPU: {torch.cuda.get_device_name(0)}')\n",
    "    print(f'  📊 GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1024**3:.1f} GB')\n",
    "    print(f'  🚀 sherpa-onnx will use GPU for STT (2-3x faster!)')\n",
    "else:\n",
    "    print('  ⚠️  No CUDA GPU detected - using CPU mode')\n",
    "    print('   💡 YouTube transcript-first mode will be even faster (no STT needed!)')\n"
   ]
  },
