    "# ==========================================\n",
    "# CELL 3: Configure Custom AI Key & Performance Settings\n",
    "# ==========================================\n",
    "\n",
    "# Get the custom AI key from user\n",
    "import getpass\n",
    "\n",
    "ai_key = getpass.getpass('🔑 Enter your Custom AI API key: ').strip()\n",
    "\n",
    "# Also need the base URL for your OpenAI-compatible service\n",
    "ai_base_url = input('🌐 Enter your OpenAI-compatible base URL (e.g., https://api.groq.com/v1 or your custom): ').strip()\n",
    "\n",
    "# Set environment variables for ClipKontrast with OPTIMIZATIONS enabled\n",
    "import os\n",
    "\n",
    "# --- AI CONFIGURATION ---\n",
    "os.environ['CLIPKONTRAST_AI_PROVIDER'] = 'custom'\n",
    "# **OPTIMIZATION**: Use fastest model - gpt-4o-mini is fast, adjust as needed\n",
    "os.environ['CLIPKONTRAST_AI_MODELS'] = 'gpt-4o-mini,google/gemini-2.5-flash'\n",
    "os.environ['CLIPKONTRAST_AI_KEY'] = ai_key\n",
    "os.environ['CLIPKONTRAST_AI_BASE_URL'] = ai_base_url.rstrip('/')\n",
    "\n",
    "# --- PERFORMANCE OPTIMIZATIONS ---\n",
    "# GPU acceleration for STT\n",
    "os.environ['SHERPA_ONNX_OFFLOAD'] = '1'  # Offload to GPU if available (Colab CUDA)\n",
    "\n",
    "# Concurrent video processing (set to 3 for your use case)\n",
    "os.environ['CLIPKONTRAST_JOB_WORKERS'] = '3'\n",
    "\n",
    "# YouTube transcript-first mode (FASTEST - skips full audio download)\n",
    "os.environ['CLIPKONTRAST_FAST_URLS'] = '1'\n",
    "os.environ['CLIPKONTRAST_YT_TRANSCRIPT'] = '1'\n",
    "\n",
    "# Skip static scenes (speeds up processing, minor quality tradeoff)\n",
    "os.environ['CLIPKONTRAST_SKIP_STATIC'] = '1'\n",
    "\n",
    "# Reduced AI timeout (faster responses)\n",
    "os.environ['CLIPKONTRAST_LIVE_AI_TIMEOUT'] = '30'\n",
    "\n",
    "# Disable update checks for speed\n",
    "os.environ['CLIPKONTRAST_UPDATE_CHECK'] = '0'\n",
    "\n",
    "# No accounts needed for personal use\n",
    "os.environ['CLIPKONTRAST_ACCOUNTS'] = '0'\n",
    "\n",
    "# Faster model fetching (load on first use, not pre-download)\n",
    "os.environ['CLIPKONTRAST_FETCH_MODEL'] = '0'\n",
    "\n",
    "# Python unbuffered for real-time output\n",
    "os.environ['PYTHONUNBUFFERED'] = '1'\n",
    "\n",
    "# Verify all settings\n",
    "print('\\n📋 AI Configuration:')\n",
    f"  Provider: {os.environ['CLIPKONTRAST_AI_PROVIDER']}`\n",
    f"  Models: {os.environ['CLIPKONTRAST_AI_MODELS']}`\n",
    f"  Base URL: {os.environ['CLIPKONTRAST_AI_BASE_URL']}`\n",
    "print('  ✅ Custom AI key configured!')\n",
    "\n",
    "print('\\n⚙️ Performance Optimizations Enabled:')\n",
    "  print(f'  • GPU offloading: {os.environ.get(\"SHERPA_ONNX_OFFLOAD\")}')\n",
    "  print(f'  • Job workers (concurrent): {os.environ.get(\"CLIPKONTRAST_JOB_WORKERS\")}')\n",
    "  print(f'  • Transcript-first mode: {os.environ.get(\"CLIPKONTRAST_FAST_URLS\")}')\n",
    "  print(f'  • Skip static scenes: {os.environ.get(\"CLIPKONTRAST_SKIP_STATIC\")}')\n",
    "  print(f'  • AI timeout: {os.environ.get(\"CLIPKONTRAST_LIVE_AI_TIMEOUT\")}s')\n",
    "  print(f'  • Update check disabled: {os.environ.get(\"CLIPKONTRAST_UPDATE_CHECK\")}')\n",
    "  print(f'  • Accounts mode: {os.environ.get(\"CLIPKONTRAST_ACCOUNTS\")}')\n",
    "  print(f'  • Model fetch mode: {os.environ.get(\"CLIPKONTRAST_FETCH_MODEL\")}')\n",
    "\n",
    "print('\\n✅ All performance settings configured!')"
   ]
  },
