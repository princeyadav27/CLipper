    "# ==========================================\n",
    "# CELL 2: Clone ClipKontrast Project\n",
    "# ==========================================\n",
    "\n",
    "# Clone the repository to /content/ClipKontrast\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "# Remove if exists, then clone\n",
    "clone_dir = Path('/content/ClipKontrast')\n",
    "if clone_dir.exists():\n",
    "    import shutil\n",
    "    shutil.rmtree(clone_dir)\n",
    "\n",
    "!git clone https://github.com/anistroz/Agak /content/ClipKontrast 2>&1 | tail -3\n",
    "\n",
    "# Change to the project directory\n",
    "os.chdir('/content/ClipKontrast')\n",
    "print(f'📁 Project directory: {os.getcwd()}')\n",
    "\n",
    "# Verify key files exist\n",
    "key_files = ['studio/server.py', 'studio/ai.py', 'studio/config.py', 'requirements.txt']\n",
    "for f in key_files:\n",
    "    exists = Path(f).exists()\n",
    "    print(f'  {f}: {\"✅\" if exists else \"❌\"}')"
   ]
