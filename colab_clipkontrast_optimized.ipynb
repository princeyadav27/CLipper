    "# ==========================================\n",
    "# CELL 1: Install Dependencies & Setup\n",
    "# ==========================================\n",
    "\n",
    "# Update apt and install system dependencies\n",
    "%system apt-get update -qq && apt-get install -y ffmpeg 2>&1 | tail -5\n",
    "\n",
    "# Install Python packages - may take a minute\n",
    "%system pip install -q fastapi==0.100.0 uvicorn==0.27.0 httpx==0.25.1 numpy==1.26.4 psycopg==3.1.0 python-multipart sherpa-onnx==2.0.1 soundfile==0.13.2 yt-dlp==2024.10.2 pillow==11.0.0 2>&1 | tail -5\n",
    "\n",
    "# Verify installations\n",
    "import fastapi, uvicorn, httpx, numpy, psycopg, sherpa_onnx, soundfile, yt_dlp, PIL\n",
    "print('✅ All core packages imported successfully!')\n",
    "\n",
    "# upgrade pip and install remaining deps\n",
    "%system pip install -q 'python-multipart>=0.0.32' 2>&1 | tail -3"
   ]
