    "# ==========================================\n",
    "# CELL 6: Start ClipKontrast Server with Optimizations\n",
    "# ==========================================\n",
    "\n",
    "# Start the FastAPI server on Colab port 8765 with all optimizations active\n",
    "import subprocess\n",
    "import sys\n",
    "import time\n",
    "import urllib.request\n",
    "\n",
    "print('🚀 Starting ClipKontrast server with ALL optimizations...')\n",
    "print('   (First start may take 1-3 minutes - model loads on first use)')\n",
    "\n",
    "server = subprocess.Popen(\n",
    "    [sys.executable, '-m', 'studio.server'],\n",
    "    cwd='/content/ClipKontrast',\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.STDOUT,\n",
    "    text=True\n",
    ")\n",
    "\n",
    "# Wait for server to be ready (poll healthz endpoint)\n",
 "for _ in range(120):\n",
    "    try:\n",
    "        resp = urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=2)\n",
    "        if resp.status == 200:\n",
    "            break\n",
    "    except Exception:\n",
    "        pass\n",
    "    time.sleep(1)\n",
    "\n",
    "# Check if server started\n",
    "if _ == 119:\n",
    "    print('❌ Server failed to start!')\n",
    "    print('Checking last 800 chars of output:')\n",
    "    output = server.stdout.read()\n",
    "    print(output[-800:])\n",
    "    sys.exit(1)\n",
    "\n",
    "print('✅ ClipKontrast is running on http://127.0.0.1:8765')\n",
    "\n",
    "# Read some initial output to confirm model loading\n",
    "output = server.stdout.read()\n",
    "if 'model' in output.lower() or 'loading' in output.lower():\n",
    "    print('\\n📥 Model loading in progress...')\n",
    "    print('   This is normal - first video may be slower, subsequent ones use cache')\n",
    "elif 'ready' in output.lower() or 'started' in output.lower():\n",
    "    print('\\n✅ Server fully operational!')\n"
   ]
