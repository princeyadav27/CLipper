    "# ==========================================\n",
    "# CELL 4: Configure Colab Settings & Data Folder\n",
    "# ==========================================\n",
    "\n",
    "# Set Colab-optimized settings\n",
    "os.environ['CLIPKONTRAST_DATA'] = '/content/ClipKontrast/data'\n",
    "os.environ['CLIPKONTRAST_HOST'] = '0.0.0.0'\n",
    "os.environ['CLIPKONTRAST_PORT'] = '8765'\n",
    "os.environ['CLIPKONTRAST_HOST'] = '0.0.0.0'\n",
    "os.environ['CLIPKONTRAST_PORT'] = '8765'\n",
    "os.environ['CLIPKONTRAST_ACCOUNTS'] = '0'  # No sign-in needed for personal use\n",
    "os.environ['CLIPKONTRAST_UPDATE_CHECK'] = '0'\n",
    "os.environ['CLIPKONTRAST_FAST_URLS'] = '1'  # Use YouTube transcripts first (faster!)\n",
    "os.environ['CLIPKONTRAST_YT_TRANSCRIPT'] = '1'\n",
    "os.environ['CLIPKONTRAST_FETCH_MODEL'] = '0'  # Skip pre-download, load on first use\n",
    "os.environ['PYTHONUNBUFFERED'] = '1'\n",
    "\n",
    "# Create data directory\n",
    "import pathlib\n",
    "data_dir = pathlib.Path('/content/ClipKontrast/data')\n",
    "data_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Create subdirectories\n",
    "for sub in ['users', 'tmp', 'models', 'fonts', 'clips', 'recordings']:\n",
    "    (data_dir / sub).mkdir(exist_ok=True)\n",
    "\n",
    "# Copy fonts from studio/fonts to data/fonts for consistent rendering\n",
    "import shutil\n",
    "fonts_src = Path('/content/ClipKontrast/studio/fonts')\n",
    "fonts_dst = data_dir / 'fonts'\n",
    "if fonts_src.exists():\n",
    "     shutil.copytree(fonts_src, fonts_dst, dirs_exist_ok=True)\n",
    "     print('🔤 Fonts copied successfully!')\n",
    "else:\n",
    "     print('⚠️  No source fonts folder found, using defaults')\n",
    "\n",
    "# Set AI ready flag\n",
    "os.environ['CLIPKONTRAST_AI_READY'] = 'true'\n",
    "\n",
    "print('✅ Colab configuration complete!')\n",
    f"📁 Data folder: {data_dir}`\n",
    "\n",
    "# Print summary of all settings\n",
    "print('\\n📊 Configuration Summary:')\n",
    "  print(f'  Host: {os.environ.get(\"CLIPKONTRAST_HOST\")}')\n",
    "  print(f'  Port: {os.environ.get(\"CLIPKONTRAST_PORT\")}')\n",
    "  print(f'  Accounts: {os.environ.get(\"CLIPKONTRAST_ACCOUNTS\")}')\n",
    "  print(f'  Fast URLs (transcript-first): {os.environ.get(\"CLIPKONTRAST_FAST_URLS\")}')\n",
    "  print(f'  YT Transcript: {os.environ.get(\"CLIPKONTRAST_YT_TRANSCRIPT\")}')\n",
    "  print(f'  AI Provider: {os.environ.get(\"CLIPKONTRAST_AI_PROVIDER\")}')\n",
    "  print(f'  AI Key: **********`"
   ]
