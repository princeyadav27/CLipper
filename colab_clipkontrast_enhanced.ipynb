    "# ==========================================\n",
    "# CELL 5: Download Speech Model (GPU-Accelerated)\n",
    "# ==========================================\n",
    "\n",
    "# The speech model (~480MB) can be pre-downloaded or loaded on first use\n",
    "# With CLIPKONTRAST_FETCH_MODEL=0, it loads on first request (faster startup)\n",
    "# With GPU enabled, sherpa-onnx can use GPU for STT\n",
    "\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "print('📥 Checking/Downloading speech model...')\n",
    "\n",
    "# The fetch_model module handles downloading the Parakeet model\n",
    "result = subprocess.run(\n",
    "    [sys.executable, '-m', 'studio.fetch_model', 'ensure'],\n",
    "    cwd='/content/ClipKontrast',\n",
    "    capture_output=True,\n",
    "    text=True\n",
    ")\n",
    "print(result.stdout[-500:] if len(result.stdout) > 500 else result.stdout)\n",
    "print(result.stderr[-500:] if len(result.stderr) > 500 else result.stderr)\n",
    "\n",
    "if result.returncode == 0:\n",
    "    print('✅ Speech model ready!')\n",
    "else:\n",
    "    print('⚠️  Model download had issues, but app will download on first use')\n",
    "\n",
    "# Check if GPU is available for sherpa-onnx\n",
    "print('\\n🖥️ GPU Check:')\n",
    "import torch\n",
    "if torch.cuda.is_available():\n",
    "    print(f'  ✅ CUDA available! GPU: {torch.cuda.get_device_name(0)}')\n",
    "    print(f'  GPU count: {torch.cuda.device_count()}')\n",
    "else:\n",
    "    print('  ⚠️  No CUDA GPU detected - will use CPU for STT')\n",
    "    print('     (YouTube transcript-first mode will still work fast!)')"
   ]
  },
